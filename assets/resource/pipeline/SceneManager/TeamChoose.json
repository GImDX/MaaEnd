{
    "__ScenePrivateTeamChooseEnter": {
        "desc": "检查战斗状态后进入编队界面",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "SceneAnyEnterWorld",
                        "__ScenePrivateTeamChooseCombatCheck",
                        "SceneEnterMenuTeam"
                    ]
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Action.Succeeded": "进入队伍界面"
        }
    },
    "__ScenePrivateTeamChooseCombatCheck": {
        "desc": "进入编队界面前检查是否处于战斗状态",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "SceneChooseTeamInCombatTeleport",
            "SceneChooseTeamInCombatFailed",
            "__ScenePrivateTeamChooseNotInCombat"
        ]
    },
    "__ScenePrivateTeamChooseInCombatTeleport": {
        "desc": "处于战斗状态时传送至四号谷地枢纽区并检查是否脱离战斗",
        "recognition": "And",
        "all_of": [
            "InWorldCombat"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterWorldValleyIVTheHub",
                "__ScenePrivateTeamChoosePostTeleportCheck"
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Action.Starting": "处于战斗状态，正在通过传送脱离战斗"
        }
    },
    "__ScenePrivateTeamChooseInCombatFailed": {
        "desc": "处于战斗状态且未允许通过传送脱离战斗",
        "recognition": "And",
        "all_of": [
            "InWorldCombat"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "FalseAction",
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Action.Failed": "当前处于战斗状态，队伍选择任务已终止"
        }
    },
    "__ScenePrivateTeamChooseNotInCombat": {
        "desc": "当前不处于战斗状态，可以进入编队界面",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ScenePrivateTeamChoosePostTeleportCheck": {
        "desc": "传送后检查是否已经脱离战斗",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__ScenePrivateTeamChoosePostTeleportStillInCombat",
            "__ScenePrivateTeamChoosePostTeleportEscaped"
        ]
    },
    "__ScenePrivateTeamChoosePostTeleportStillInCombat": {
        "desc": "传送后仍处于战斗状态",
        "recognition": "And",
        "all_of": [
            "InWorldCombat"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "FalseAction",
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Action.Failed": "传送后仍处于战斗状态，队伍选择任务已终止"
        }
    },
    "__ScenePrivateTeamChoosePostTeleportEscaped": {
        "desc": "传送后已返回非战斗大世界",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ScenePrivateTeamChooseTabAnchor": {
        "desc": "识别左下角队伍 tab 的编辑图标",
        "recognition": "TemplateMatch",
        "roi": [
            0,
            -90,
            100,
            70
        ],
        "template": "SceneManager/TeamChooseTabEdit.png",
        "threshold": 0.9,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ScenePrivateTeamChooseConfirm": {
        "desc": "根据出战按钮状态确认是否需要切换当前出战队伍",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__ScenePrivateTeamChooseDeploy",
            "__ScenePrivateTeamChooseAlreadyDeployed",
            "__ScenePrivateTeamChooseFailed"
        ]
    },
    "__ScenePrivateTeamChooseDeployButtonState": {
        "desc": "识别黄色出战按钮",
        "recognition": "TemplateMatch",
        "roi": [
            1080,
            600,
            200,
            120
        ],
        "template": [
            "Common/Button/YellowConfirmButtonType2.png",
            "Common/Button/YellowConfirmButtonType2Hover.png"
        ],
        "threshold": 0.9,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ScenePrivateTeamChooseAlreadyDeployedButtonState": {
        "desc": "识别白色已出战按钮",
        "recognition": "TemplateMatch",
        "roi": [
            1080,
            600,
            200,
            120
        ],
        "template": [
            "Common/Button/WhiteConfirmButtonType2.png",
            "Common/Button/WhiteConfirmButtonType2Hover.png"
        ],
        "threshold": 0.9,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ScenePrivateTeamChooseDeploy": {
        "desc": "点击黄色出战按钮切换当前出战队伍",
        "recognition": "And",
        "all_of": [
            "__ScenePrivateTeamChooseTabAnchor",
            "__ScenePrivateTeamChooseDeployButtonState"
        ],
        "pre_delay": 0,
        "action": "Click",
        "target": [
            1080,
            600,
            200,
            120
        ],
        "post_wait_freezes": {
            "time": 200,
            "target": [
                1080,
                600,
                200,
                120
            ]
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__ScenePrivateTeamChooseDeploySucceeded",
            "__ScenePrivateTeamChooseDeployNotApplied",
            "__ScenePrivateTeamChooseFailed"
        ],
        "focus": {
            "Node.Action.Succeeded": "确认切换出战队伍"
        }
    },
    "__ScenePrivateTeamChooseAlreadyDeployed": {
        "desc": "目标队伍已经出战，无需再次切换",
        "recognition": "And",
        "all_of": [
            "__ScenePrivateTeamChooseTabAnchor",
            "__ScenePrivateTeamChooseAlreadyDeployedButtonState"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__ScenePrivateTeamChooseReturnWorld"
        ]
    },
    "__ScenePrivateTeamChooseDeploySucceeded": {
        "desc": "点击出战后按钮已切换为白色已出战状态",
        "recognition": "And",
        "all_of": [
            "__ScenePrivateTeamChooseTabAnchor",
            "__ScenePrivateTeamChooseAlreadyDeployedButtonState"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__ScenePrivateTeamChooseReturnWorld"
        ]
    },
    "__ScenePrivateTeamChooseDeployNotApplied": {
        "desc": "点击出战后黄色按钮仍然存在，队伍切换未生效",
        "recognition": "And",
        "all_of": [
            "__ScenePrivateTeamChooseTabAnchor",
            "__ScenePrivateTeamChooseDeployButtonState"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "FalseAction",
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Action.Failed": "点击出战后队伍切换未生效"
        }
    },
    "__ScenePrivateTeamChooseFailed": {
        "desc": "无法识别目标队伍或出战按钮状态",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "FalseAction",
        "post_delay": 0,
        "rate_limit": 0,
        "focus": {
            "Node.Action.Failed": "无法确认目标队伍或出战按钮状态"
        }
    },
    "__ScenePrivateTeamChooseReturnWorld": {
        "desc": "返回大世界",
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SubTask",
                "custom_action_param": {
                    "sub": [
                        "SceneAnyEnterWorld"
                    ]
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0
    }
}
